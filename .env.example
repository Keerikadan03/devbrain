# Copy to .env and fill in. docker compose reads .env automatically.
# Only ANTHROPIC_API_KEY is required; everything else has a working default.

# ---- LLM (required) ----
# Key from https://console.anthropic.com (an API key, not a Claude.ai subscription)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ---- Database credentials (change these for anything internet-facing) ----
POSTGRES_DB=devbrain
POSTGRES_USER=devbrain
POSTGRES_PASSWORD=devbrain
# Neo4j needs at least 8 characters
NEO4J_PASSWORD=devbrain123

# ---- Ports published on the host ----
FRONTEND_PORT=3000
BACKEND_PORT=8080
POSTGRES_HOST_PORT=5433
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
KAFKA_HOST_PORT=9092

# URL of the backend as the *browser* reaches it. Baked into the UI at build time,
# so after changing it run `docker compose up --build`. For a server: http://<your-host>:8080
NEXT_PUBLIC_API_URL=http://localhost:8080

# ---- Features ----
# Name topic clusters with one batched LLM call (false = keyword names, no LLM cost)
TOPICS_LLM_NAMES=true
# Transcribe videos without captions locally with whisper.cpp
WHISPER_ENABLED=true
# Whisper model baked into the backend image: tiny.en | base.en | small.en | medium.en (bigger = slower, better)
WHISPER_MODEL=base.en
# Path *inside the backend container* to an exported cookies.txt, for login-walled videos (e.g. Instagram).
# Mount it with a docker-compose.override.yml (see README).
YTDLP_COOKIES_FILE=

# JVM options for the backend container
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75
